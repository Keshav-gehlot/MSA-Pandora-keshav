# Environment variables for apps/web. Copy to .env.local and fill in. Never commit .env.local.

# Dev database (Neon). Ask Ojas for the URL. Tests never need it.
DATABASE_URL=
# Optional, for `pnpm --filter @pandora/db migrate`: a different URL for migrations (production uses
# Supabase's session pooler, port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATE_URL=
# For `pnpm --filter @pandora/db seed`: staff to create, as email:Name:role;email:Name:role (role admin or staff).
SEED_STAFF=

# Email: "file" writes to MAIL_OUTBOX_PATH instead of sending (default). "resend" sends for real.
MAIL_TRANSPORT=file
MAIL_OUTBOX_PATH=.mail/outbox.jsonl
RESEND_API_KEY=
EMAIL_FROM=MSA Pandora <pandora@recruitments.msasrm.in>
# Comma-separated. When set, email to anyone else is skipped (used on previews).
MAIL_ALLOWLIST=

# File storage: nothing to set. Locally, uploads go to .storage/ on disk; deployed, they go to the R2 bucket
# bound as UPLOADS in wrangler.jsonc.

# "true" adds the payment step to registration.
PAYMENT_ENABLED=false

# Secret used to sign/verify event check-in passes. Server-only, at least 32 random bytes.
PASS_SECRET=

# Episode 0 submission deadline, an ISO timestamp such as 2026-10-15T23:59:00+05:30. Unset means submissions are open.
EPISODE_0_DEADLINE=
